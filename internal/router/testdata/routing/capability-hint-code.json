{
  "description": "A code keyword in a plain message routes through capabilityRouting",
  "providers": [
    {
      "name": "cheap",
      "weight": 5,
      "capabilities": [
        "code"
      ],
      "contextWindow": 128000,
      "costPerInputToken": 1.5e-7,
      "latencyProfile": "fast"
    },
    {
      "name": "big",
      "weight": 3,
      "capabilities": [
        "vision",
        "reasoning"
      ],
      "contextWindow": 1000000,
      "costPerInputToken": 0.000003,
      "latencyProfile": "medium"
    },
    {
      "name": "reserve",
      "weight": 0,
      "capabilities": [
        "vision"
      ],
      "contextWindow": 10000000,
      "latencyProfile": "fast"
    }
  ],
  "capabilityRouting": {
    "code": "big"
  },
  "messages": [
    {
      "role": "user",
      "content": "please implement a function"
    }
  ],
  "expect": {
    "provider": "big",
    "path": "rule:capability:code",
    "stage": "chat"
  }
}
