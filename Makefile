build-ui-proxy: ## Build the UIProxy binary (requires npm run build first).
	@echo "Building React SPA..."
	cd ui && npm run build
	@echo "Copying dist to cmd/ui-proxy/dist/..."
	rm -rf cmd/ui-proxy/dist && cp -r ui/dist cmd/ui-proxy/dist
	@echo "Building ui-proxy binary..."
	go build -o bin/ui-proxy ./cmd/ui-proxy

