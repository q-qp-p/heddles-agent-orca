# cmd/ui-proxy/main.go uses `//go:embed dist`. The dist directory is gitignored
# (it is generated by `make build-ui-proxy` or inside the Dockerfile from the
# real React SPA). `go:embed` requires at least one non-hidden file in the
# directory (it ignores dotfiles and an empty directory is not embeddable), so
# we create a minimal placeholder here for tools that type-check the package
# (`go vet`, `golangci-lint`, `go test`) without needing the full SPA build.
.PHONY: ui-proxy-dist
ui-proxy-dist:
	@mkdir -p cmd/ui-proxy/dist
	@test -f cmd/ui-proxy/dist/index.html || \
		printf '<!-- stub for go:embed (gitignored) -->\n' > cmd/ui-proxy/dist/index.html

.PHONY: fmt
fmt: ui-proxy-dist ## Run go fmt against code.
	go fmt ./...

.PHONY: vet
vet: ui-proxy-dist ## Run go vet against code.
	go vet ./...

# Module-wide coverage: include all packages when any test runs (cross-package attribution).
# Per-package lines still show 0%% for packages that have no *_test.go; see total line after tests.
# Disable with: make test COVERPKG=
COVERPKG ?= $(shell go list -m)/...

.PHONY: test
test: manifests generate fmt vet setup-envtest ## Run tests.
	KUBEBUILDER_ASSETS="$(shell "$(ENVTEST)" use $(ENVTEST_K8S_VERSION) --bin-dir "$(LOCALBIN)" -p path)" \
		go test $(if $(COVERPKG),-coverpkg=$(COVERPKG)) $$(go list ./... | grep -v /e2e) -coverprofile cover.out
	@echo ""
	@echo "Total coverage (merged profile):"
	@go tool cover -func cover.out | tail -1

# TODO(user): To use a different vendor for e2e tests, modify the setup under 'tests/e2e'.
# The default setup assumes Kind is pre-installed and builds/loads the Manager Docker image locally.
# CertManager is installed by default; skip with:
# - CERT_MANAGER_INSTALL_SKIP=true
KIND_CLUSTER ?= agent-orca-test-e2e

# test-e2e: unified suite — creates a Kind cluster, deploys the operator, and runs all tests.
#
# Test tiers (controlled by env vars):
#   default             operator + webhook + split-pod resource creation tests
#   STREAMING_E2E=true  + SSE token streaming (needs LLM credentials)
#
# Examples:
#   make test-e2e
#   STREAMING_E2E=true make test-e2e
.PHONY: setup-test-e2e
setup-test-e2e: ## Set up a fresh Kind cluster for e2e tests (deletes existing cluster if present)
	@command -v $(KIND) >/dev/null 2>&1 || { \
		echo "Kind is not installed. Please install Kind manually."; \
		exit 1; \
	}
	@case "$$($(KIND) get clusters)" in \
		*"$(KIND_CLUSTER)"*) \
			echo "Deleting existing Kind cluster '$(KIND_CLUSTER)'..."; \
			$(KIND) delete cluster --name $(KIND_CLUSTER) ;; \
	esac
	@echo "Creating Kind cluster '$(KIND_CLUSTER)'..."
	@$(KIND) create cluster --name $(KIND_CLUSTER)

# test-e2e: unified suite — creates a Kind cluster, deploys the operator, and runs all tests.
#
# Test tiers (controlled by env vars):
#   default             operator + webhook tests (manager)
#   STREAMING_E2E=true  + SSE token streaming tests (needs LLM credentials)
#   ROUTING_E2E=true    + routing telemetry tests (deploys PostgreSQL and a fake LLM; no credentials)
# E2E_LABEL narrows the run to specs carrying a Ginkgo label, e.g. routing-e2e.
#
# Examples:
#   make test-e2e
#   STREAMING_E2E=true make test-e2e
#   ROUTING_E2E=true E2E_LABEL=routing-e2e make test-e2e
E2E_LABEL ?=
.PHONY: test-e2e
test-e2e: setup-test-e2e manifests generate fmt vet ## Run the e2e suite
	KIND=$(KIND) KIND_CLUSTER=$(KIND_CLUSTER) ROUTER_IMG=$(ROUTER_IMG) STREAMING_E2E=$(STREAMING_E2E) go test -tags=e2e ./test/e2e/ -v -ginkgo.v -ginkgo.label-filter='$(E2E_LABEL)'
	$(MAKE) cleanup-test-e2e

.PHONY: lint-demos
lint-demos: ## Validate all demo Helm charts render valid Kubernetes YAML.
	@fail=0; \
	for chart in charts/demos/*/; do \
		name=$$(basename "$$chart"); \
		if ! helm template "$$name" "$$chart" --namespace agent-orca-system > /tmp/agent-orca-lint-demo.yaml 2>&1; then \
			echo "FAIL: $$name (helm template error)"; \
			cat /tmp/agent-orca-lint-demo.yaml; \
			fail=1; \
		elif ! kubectl apply --dry-run=client -f /tmp/agent-orca-lint-demo.yaml > /dev/null 2>&1; then \
			echo "FAIL: $$name (kubectl dry-run error)"; \
			kubectl apply --dry-run=client -f /tmp/agent-orca-lint-demo.yaml 2>&1 | grep -i error || true; \
			fail=1; \
		else \
			echo "OK: $$name"; \
		fi; \
	done; \
	rm -f /tmp/agent-orca-lint-demo.yaml; \
	if [ "$$fail" -ne 0 ]; then exit 1; fi

.PHONY: cleanup-test-e2e
cleanup-test-e2e: ## Tear down the Kind cluster used for e2e tests
	@$(KIND) delete cluster --name $(KIND_CLUSTER)

.PHONY: test-ui
