# Ignore everything, re-include only what the Dockerfiles explicitly COPY.
**

# Go source (excluding tests)
!cmd
!cmd/**
!internal
!internal/**
!api
!api/**
!pkg
!pkg/**
!go.mod
!go.sum
# Vendored Go modules that go.mod replaces with a local directory (Switchyard).
!third_party
!third_party/**
**/*_test.go

# React UI source (Dockerfile.ui-proxy Stage 1)
!ui
!ui/package.json
!ui/package-lock.json*
!ui/tsconfig.json
!ui/vite.config.ts
!ui/index.html
!ui/src
!ui/src/**

# Project logo — single source of truth, copied into the UI build by Dockerfile.ui-proxy.
!assets
!assets/logo.png

# Reference agent image (examples/agent-sdk-template/Dockerfile) needs the Python SDK
# and the template entrypoint. Selectively re-include them (base context is `**`).
!pkg/python/agentorca
!pkg/python/agentorca/**
!examples/agent-sdk-template
!examples/agent-sdk-template/**

# Fake LLM server for e2e tests (test/fakellm/Dockerfile).
!test
!test/fakellm
!test/fakellm/**
